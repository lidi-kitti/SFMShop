# Скопируйте в .env и подставьте свои значения:  cp .env.example .env
# Имена совпадают с кодом: connection.py, cache_service.py, log_service.py, auth.py
# В Docker/K8s хосты — имена сервисов (db, redis, mongo), не localhost.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sfmshop
DB_USER=postgres
DB_PASSWORD=user
# Реплика: если не заданы, используется DB_HOST / DB_PORT
DB_PRIMARY_HOST=localhost
DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB (логи)
MONGO_HOST=localhost
MONGO_PORT=27017

# JWT
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# API
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
RATE_LIMIT_PRODUCTS=30/minute
RATE_LIMIT_LOGIN=5/minute

# Опционально
ANTHROPIC_API_KEY=
SENTRY_DSN=

# Settings (src/core/config.py)
DATABASE_URL=
SECRET_KEY=
REDIS_URL=
DEBUG=true
MAX_CONNECTIONS=10
